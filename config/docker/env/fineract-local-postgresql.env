#
# Environment variables for connecting to LOCAL PostgreSQL
# running on the host machine (not in Docker).
#
# IMPORTANT: Update the credentials below to match your local PostgreSQL setup.
#

# --- Hikari connection pool (tenant store DB) ---
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/fineract_tenants
FINERACT_HIKARI_USERNAME=postgres
FINERACT_HIKARI_PASSWORD=postgres

# --- Default tenant database ---
FINERACT_DEFAULT_TENANTDB_HOSTNAME=host.docker.internal
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_UID=postgres
FINERACT_DEFAULT_TENANTDB_PWD=postgres
FINERACT_DEFAULT_TENANTDB_NAME=fineract_default
