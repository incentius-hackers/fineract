<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Add per-rule processing direction override to loan product payment allocation rules -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_loan_product_payment_allocation_rule"/>
                <not><columnExists tableName="m_loan_product_payment_allocation_rule" columnName="processing_direction"/></not>
            </and>
        </preConditions>
        <addColumn tableName="m_loan_product_payment_allocation_rule">
            <column name="processing_direction" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add per-rule processing direction override to loan payment allocation rules -->
    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_loan_payment_allocation_rule"/>
                <not><columnExists tableName="m_loan_payment_allocation_rule" columnName="processing_direction"/></not>
            </and>
        </preConditions>
        <addColumn tableName="m_loan_payment_allocation_rule">
            <column name="processing_direction" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add permissions for the new SETTLEMENT transaction type -->
    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
            <not><sqlCheck expectedResult="1">SELECT COUNT(*) FROM m_permission WHERE code = 'SETTLEMENT_LOAN'</sqlCheck></not>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="SETTLEMENT_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="SETTLEMENT"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- Add business event configuration for Settlement -->
    <changeSet author="fineract" id="4">
        <preConditions onFail="MARK_RAN">
            <not><sqlCheck expectedResult="1">SELECT COUNT(*) FROM m_external_event_configuration WHERE type = 'LoanTransactionSettlementPreBusinessEvent'</sqlCheck></not>
        </preConditions>
        <insert tableName="m_external_event_configuration">
            <column name="type" value="LoanTransactionSettlementPreBusinessEvent"/>
            <column name="enabled" valueBoolean="false"/>
        </insert>
        <insert tableName="m_external_event_configuration">
            <column name="type" value="LoanTransactionSettlementPostBusinessEvent"/>
            <column name="enabled" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
